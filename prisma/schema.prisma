generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int                @id @default(autoincrement())
  email            String             @unique
  passwordHash     String             @map("password_hash")
  displayName      String             @map("display_name")
  employeeId       Int?               @map("employee_id")
  isActive         Int                @default(1) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")
  auditLogs        AuditLog[]
  issuedDiscipline DisciplineRecord[] @relation("DisciplineIssuer")
  assignedTickets  Ticket[]           @relation("TicketAssignee")
  createdTickets   Ticket[]           @relation("TicketCreator")
  userRoles        UserRole[]
  employee         Employee?          @relation(fields: [employeeId], references: [id])
  approvalRequests ApprovalRequest[]   @relation("ApprovalRequester")

  @@map("users")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  code            String           @unique
  description     String?
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  roleId Int  @map("role_id")
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Employee {
  id                       Int                  @id @default(autoincrement())
  empNo                    String?              @map("emp_no")
  firstName                String?              @map("first_name")
  lastName                 String?              @map("last_name")
  email                    String?
  phone                    String?
  departmentId             Int?                 @map("department_id")
  positionId               Int?                 @map("position_id")
  managerId                Int?                 @map("manager_id")
  joinDate                 String?              @map("join_date")
  status                   String?              @default("Active")
  avatarUrl                String?              @map("avatar_url")
  basicSalary              Float?               @map("basic_salary")
  bankName                 String?              @map("bank_name")
  iban                     String?
  routingCode              String?              @map("routing_code")
  nationality              String?
  gender                   String?
  dateOfBirth              String?              @map("date_of_birth")
  maritalStatus            String?              @map("marital_status")
  passportNumber           String?              @map("passport_number")
  passportExpiry           String?              @map("passport_expiry")
  emiratesId               String?              @map("emirates_id")
  emiratesIdExpiry         String?              @map("emirates_id_expiry")
  visaType                 String?              @map("visa_type")
  visaExpiry               String?              @map("visa_expiry")
  unifiedNumber            String?              @map("unified_number")
  personalEmail            String?              @map("personal_email")
  residentialAddress       String?              @map("residential_address")
  homeCountryAddress       String?              @map("home_country_address")
  emergencyContactName     String?              @map("emergency_contact_name")
  emergencyContactRelation String?              @map("emergency_contact_relation")
  emergencyContactNumber   String?              @map("emergency_contact_number")
  gradeLevel               String?              @map("grade_level")
  employmentType           String?              @map("employment_type")
  workLocation             String?              @map("work_location")
  probationPeriod          String?              @map("probation_period")
  contractType             String?              @map("contract_type")
  workPermitNumber         String?              @map("work_permit_number")
  sponsorshipType          String?              @map("sponsorship_type")
  paymentMethod            String?              @default("Bank Transfer") @map("payment_method")
  wpsFileNumber            String?              @map("wps_file_number")
  swiftCode                String?              @map("swift_code")
  annualLeaveBalance       Float?               @default(30.0) @map("annual_leave_balance")
  sickLeaveBalance         Float?               @default(15.0) @map("sick_leave_balance")
  leaveAccrualRate         Float?               @default(2.5) @map("leave_accrual_rate")
  biometricId              String?              @map("biometric_id")
  mohreContractNumber      String?              @map("mohre_contract_number")
  establishmentCard        String?              @map("establishment_card")
  medicalInsurancePolicy   String?              @map("medical_insurance_policy")
  attendance               Attendance[]
  disciplineRecords        DisciplineRecord[]   @relation("EmployeeDiscipline")
  documents                Document[]
  benefits                 EmployeeBenefit[]
  onboardingTasks          EmployeeOnboarding[]
  requests                 EmployeeRequest[]
  shifts                   EmployeeShift[]
  trainings                EmployeeTraining[]
  department               Department?          @relation(fields: [departmentId], references: [id])
  positionRel              Position?            @relation(fields: [positionId], references: [id])
  leaveRequests            LeaveRequest[]
  offboardingRecord        OffboardingRecord?   @relation("EmployeeOffboarding")
  payrollItems             PayrollItem[]
  reviewsReceived          PerformanceReview[]  @relation("Reviewee")
  reviewsGiven             PerformanceReview[]  @relation("Reviewer")
  users                    User[]
  expenses                 Expense[]

  @@map("employees")
}

model LeaveType {
  id            Int            @id @default(autoincrement())
  name          String?
  code          String?
  maxDays       Int?           @map("max_days")
  isPaid        Int?           @map("is_paid")
  leaveRequests LeaveRequest[]

  @@map("leave_types")
}

model LeaveRequest {
  id          Int        @id @default(autoincrement())
  employeeId  Int?       @map("employee_id")
  leaveTypeId Int?       @map("leave_type_id")
  startDate   String?    @map("start_date")
  endDate     String?    @map("end_date")
  days        Int?
  reason      String?
  status      String     @default("PENDING")
  approverId  Int?       @map("approver_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  employee    Employee?  @relation(fields: [employeeId], references: [id])
  leaveType   LeaveType? @relation(fields: [leaveTypeId], references: [id])

  @@map("leave_requests")
}

model Attendance {
  id            Int       @id @default(autoincrement())
  employeeId    Int?      @map("employee_id")
  date          String?
  timeIn        String?   @map("time_in")
  timeOut       String?   @map("time_out")
  totalHours    Float?    @map("total_hours")
  overtimeHours Float?    @map("overtime_hours")
  employee      Employee? @relation(fields: [employeeId], references: [id])

  @@map("attendance")
}

model PayrollRun {
  id           Int           @id @default(autoincrement())
  month        Int?
  year         Int?
  status       String?
  payrollItems PayrollItem[]

  @@map("payroll_runs")
}

model PayrollItem {
  id                 String     @id @default(uuid())
  payrollRunId       Int
  employeeId         Int
  basic              Float      @default(0.0)
  housingAllowance   Float      @default(0.0) @map("housing_allowance")
  transportAllowance Float      @default(0.0) @map("transport_allowance")
  otherAllowances    Float      @default(0.0) @map("other_allowances")
  deductions         Float      @default(0.0)
  overtime           Float      @default(0.0)
  netPay             Float      @default(0.0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  employee           Employee   @relation(fields: [employeeId], references: [id])
  payrollRun         PayrollRun @relation(fields: [payrollRunId], references: [id])

  @@map("payroll_items")
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String?
  body      String?
  priority  String?  @default("normal")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("announcements")
}

model Document {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  title      String
  type       String
  fileUrl    String   @map("file_url")
  uploadDate DateTime @default(now()) @map("upload_date")
  expiryDate String?  @map("expiry_date")
  status     String   @default("Valid")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model EmployeeRequest {
  id           Int       @id @default(autoincrement())
  employeeId   Int       @map("employee_id")
  type         String
  description  String?
  status       String    @default("Pending")
  requestDate  DateTime  @default(now()) @map("request_date")
  resolvedDate DateTime? @map("resolved_date")
  notes        String?
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_requests")
}

model Department {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  headId      Int?         @map("head_id")
  employees   Employee[]
  jobPostings JobPosting[]

  @@map("departments")
}

model Position {
  id          Int        @id @default(autoincrement())
  title       String     @unique
  description String?
  level       String?
  employees   Employee[]

  @@map("positions")
}

model Shift {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  startTime String          @map("start_time")
  endTime   String          @map("end_time")
  workDays  String
  employees EmployeeShift[]

  @@map("shifts")
}

model EmployeeShift {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  shiftId    Int      @map("shift_id")
  startDate  String   @map("start_date")
  endDate    String?  @map("end_date")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@map("employee_shifts")
}

model Benefit {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  type        String
  amount      Float?
  description String?
  employees   EmployeeBenefit[]

  @@map("benefits")
}

model EmployeeBenefit {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  benefitId  Int      @map("benefit_id")
  amount     Float?
  startDate  String   @map("start_date")
  endDate    String?  @map("end_date")
  benefit    Benefit  @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_benefits")
}

model JobPosting {
  id           String      @id @default(uuid())
  title        String
  departmentId Int
  location     String      @default("Dubai, UAE")
  type         String      @default("Full-Time")
  status       String      @default("Open")
  description  String?
  requirements String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  applicants   Applicant[]
  department   Department  @relation(fields: [departmentId], references: [id])

  @@map("job_postings")
}

model Applicant {
  id           String     @id @default(uuid())
  firstName    String
  lastName     String
  email        String
  phone        String?
  resumeUrl    String?
  status       String     @default("New")
  jobPostingId String
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id])

  @@map("applicants")
}

model OnboardingTask {
  id            String               @id @default(uuid())
  title         String
  description   String?
  roleTarget    String?
  dayDue        Int                  @default(7)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  employeeTasks EmployeeOnboarding[]

  @@map("onboarding_tasks")
}

model EmployeeOnboarding {
  id          String         @id @default(uuid())
  employeeId  Int
  taskId      String
  status      String         @default("Pending")
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  employee    Employee       @relation(fields: [employeeId], references: [id])
  task        OnboardingTask @relation(fields: [taskId], references: [id])

  @@unique([employeeId, taskId])
  @@map("employee_onboarding")
}

model PerformanceReview {
  id         String   @id @default(uuid())
  revieweeId Int
  reviewerId Int
  period     String
  rating     Int      @default(3)
  comments   String?
  goals      String?
  status     String   @default("Draft")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  reviewee   Employee @relation("Reviewee", fields: [revieweeId], references: [id])
  reviewer   Employee @relation("Reviewer", fields: [reviewerId], references: [id])

  @@map("performance_reviews")
}

model TrainingCourse {
  id          String             @id @default(uuid())
  title       String
  description String?
  instructor  String?
  duration    Int                @default(60)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  enrollments EmployeeTraining[]

  @@map("training_courses")
}

model EmployeeTraining {
  id             String         @id @default(uuid())
  employeeId     Int
  courseId       String
  status         String         @default("Enrolled")
  completionDate DateTime?
  score          Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  course         TrainingCourse @relation(fields: [courseId], references: [id])
  employee       Employee       @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, courseId])
  @@map("employee_trainings")
}

model CompanySetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("company_settings")
}

model Ticket {
  id           Int      @id @default(autoincrement())
  subject      String
  body         String?
  priority     String   @default("Normal")
  status       String   @default("Open")
  createdById  Int      @map("created_by_id")
  assignedToId Int?     @map("assigned_to_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  assignedTo   User?    @relation("TicketAssignee", fields: [assignedToId], references: [id])
  createdBy    User     @relation("TicketCreator", fields: [createdById], references: [id])

  @@map("tickets")
}

model CompanyPolicy {
  id          Int      @id @default(autoincrement())
  title       String
  content     String?
  version     String   @default("1.0")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("company_policies")
}

model AuditLog {
  id       Int     @id @default(autoincrement())
  action   String
  entity   String
  entityId String  @map("entity_id")
  userId   Int     @map("user_id")
  details  String?
  user     User    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model CompanyHoliday {
  id          Int      @id @default(autoincrement())
  title       String
  date        DateTime
  description String?
  isRecurring Boolean  @default(false) @map("is_recurring")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("company_holidays")
}

model DisciplineRecord {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  type       String
  reason     String
  date       DateTime @default(now())
  issuerId   Int      @map("issuer_id")
  status     String   @default("Active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  employee   Employee @relation("EmployeeDiscipline", fields: [employeeId], references: [id])
  issuer     User     @relation("DisciplineIssuer", fields: [issuerId], references: [id])

  @@map("discipline_records")
}

model OffboardingRecord {
  id              Int       @id @default(autoincrement())
  employeeId      Int       @unique @map("employee_id")
  status          String    @default("Initiated")
  resignationDate DateTime? @map("resignation_date")
  lastWorkingDay  DateTime? @map("last_working_day")
  isTerminated    Boolean   @default(false) @map("is_terminated")
  reason          String?
  checklist       String?
  settlement      Float?    @default(0.0)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  employee        Employee  @relation("EmployeeOffboarding", fields: [employeeId], references: [id])

  @@map("offboarding_records")
}

// -----------------------------------------------------------------------------
// PHASE 13: APPROVAL WORKFLOWS
// -----------------------------------------------------------------------------

model ApprovalWorkflow {
  id          Int      @id @default(autoincrement())
  name        String
  entityType  String   @map("entity_type") // e.g., "LeaveRequest", "Expense", "General"
  isActive    Boolean  @default(true) @map("is_active")
  steps       ApprovalStep[]
  requests    ApprovalRequest[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("approval_workflows")
}

model ApprovalStep {
  id             Int      @id @default(autoincrement())
  workflowId     Int      @map("workflow_id")
  workflow       ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepOrder      Int      @map("step_order") // 1, 2, 3
  approverRole   String?  @map("approver_role") // E.g., "Manager", "HR Admin"
  specificUserId Int?     @map("specific_user_id") // E.g., CEO
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("approval_steps")
}

model ApprovalRequest {
  id               Int      @id @default(autoincrement())
  workflowId       Int      @map("workflow_id")
  workflow         ApprovalWorkflow @relation(fields: [workflowId], references: [id])
  requesterId      Int      @map("requester_id")
  requester        User     @relation("ApprovalRequester", fields: [requesterId], references: [id])
  targetEntityId   Int?     @map("target_entity_id")
  currentStepOrder Int      @default(1) @map("current_step_order")
  status           String   @default("Pending") // Pending, Approved, Rejected
  comments         String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("approval_requests")
}

// -----------------------------------------------------------------------------
// PHASE 14: EXPENSE MANAGEMENT
// -----------------------------------------------------------------------------

model Expense {
  id           Int      @id @default(autoincrement())
  employeeId   Int      @map("employee_id")
  employee     Employee @relation(fields: [employeeId], references: [id])
  amount       Float
  category     String   // E.g., Travel, Meals, Supplies
  date         DateTime
  description  String?
  receiptUrl   String?  @map("receipt_url")
  status       String   @default("Pending") // Pending, Approved, Rejected, Paid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("expenses")
}
